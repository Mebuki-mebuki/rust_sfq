XBUFF23 _BUFF22_q _BUFF23_q THmitll_BUFF
XBUFF24 _BUFF23_q _BUFF24_q THmitll_BUFF
XBUFF25 _BUFF24_q _BUFF25_q THmitll_BUFF
XBUFF26 _BUFF25_q _BUFF26_q THmitll_BUFF
XBUFF27 _BUFF26_q _BUFF27_q THmitll_BUFF
XBUFF28 _BUFF27_q _BUFF28_q THmitll_BUFF
XBUFF29 _BUFF28_q _BUFF29_q THmitll_BUFF
XBUFF30 _BUFF29_q _BUFF30_q THmitll_BUFF
XBUFF31 _BUFF30_q _BUFF31_q THmitll_BUFF
XBUFF32 _BUFF31_q _BUFF32_q THmitll_BUFF
XBUFF33 _BUFF32_q a2_end THmitll_BUFF
XSPLIT34 clk clk1 clk2 THmitll_SPLIT
XDFF35 a1 clk1 _DFF35_q THmitll_DFF
XBUFF36 _DFF35_q _BUFF36_q THmitll_BUFF
XBUFF37 _BUFF36_q x THmitll_BUFF
XAND38 x a2_end clk2 _AND38_q THmitll_AND2
XJTL39 _AND38_q y THmitll_JTL
.ends
.subckt ClockBetweenData a b clk y
XSPLIT1 clk clk1 _SPLIT1_q2 THmitll_SPLIT
XAND2 a b clk1 x THmitll_AND2
XBUFF3 _SPLIT1_q2 _BUFF3_q THmitll_BUFF
XBUFF4 _BUFF3_q _BUFF4_q THmitll_BUFF
XBUFF5 _BUFF4_q _BUFF5_q THmitll_BUFF
XBUFF6 _BUFF5_q _BUFF6_q THmitll_BUFF
XBUFF7 _BUFF6_q clk2 THmitll_BUFF
XOR8 x y1 clk2 y0 THmitll_OR2
XSPLIT9 y0 y y1 THmitll_SPLIT
.ends
