.subckt NorPipelined a b clk y
XSPLIT1 clk clk1 clk2 THmitll_SPLIT
XOR2 a b clk1 x THmitll_OR2
XNOT3 x clk2 y THmitll_NOT
.ends
.subckt NorCombinational a b clk y
XSPLIT1 clk clk1 _SPLIT1_q2 THmitll_SPLIT
XOR2 a b clk1 x THmitll_OR2
XBUFF3 _SPLIT1_q2 _BUFF3_q THmitll_BUFF
XBUFF4 _BUFF3_q clk2 THmitll_BUFF
XNOT5 x clk2 y THmitll_NOT
.ends
.subckt SingleCyclePath a clk y
XSPLIT1 a a1 a2 THmitll_SPLIT
XSPLIT2 clk clk1 clk2 THmitll_SPLIT
XDFF3 a1 clk1 x THmitll_DFF
XAND4 x a2 clk2 _AND4_q THmitll_AND2
XJTL5 _AND4_q y THmitll_JTL
.ends
.subckt MultiCyclePath a clk y
XSPLIT1 a a1 a2_start THmitll_SPLIT
XBUFF2 a2_start _BUFF2_q THmitll_BUFF
XBUFF3 _BUFF2_q _BUFF3_q THmitll_BUFF
XBUFF4 _BUFF3_q _BUFF4_q THmitll_BUFF
